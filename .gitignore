# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfplan
*.tfplan.*
*.plan
plan.out
plan.out.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
**/backend.tf
!**/backend.tf.example

# Keep committed plan/report fixtures, ignore generated reports
reports/
*.report.json
!tests/fixtures/*.json

# ---------------------------------------------------------------------------
# Secrets and credentials  (NEVER commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa*
id_ed25519*
credentials
.aws/
.ssh/
*.kubeconfig
secrets/
*tfvars.json
*.auto.tfvars
!terraform.tfvars.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Tooling / local environment
# ---------------------------------------------------------------------------
.tools/
.scanner-cache/
.trivy/
node_modules/
*.log
!screenshots/*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------------------------------------------------------------------------
# Local evidence captures (raw command output is re-generated by scripts)
# ---------------------------------------------------------------------------
artifacts/local/
dist/
build/
