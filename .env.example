# ---------------------------------------------------------------------------
# Local environment for the automation scripts and Terraform.
#
# Copy to .env and fill in. NEVER commit the real .env file.
# Prefer short-lived credentials (AWS SSO / OIDC); access keys are a last resort
# and must be rotated within 24 hours.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=landing-zone

# Only if SSO/profile auth is unavailable (avoid in CI):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# GitHub Actions OIDC role created by modules/iam
AWS_ROLE_TO_ASSUME=arn:aws:iam::111122223333:role/eawlz-production-github-ci

# Terraform
TF_IN_AUTOMATION=1
TF_CLI_ARGS_plan=-no-color

# Scripts
LOG_LEVEL=INFO
